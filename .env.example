# Никогда не добавляйте .env с ключом в Git.
APP_MODE=test
APP_DATA_MODE=auto
APP_DB_PATH=runtime/app.sqlite
APP_HOST=127.0.0.1
APP_PORT=8000
# Для локального демо токен не нужен. Для любого внешнего bind обязателен.
APP_TOKEN=
APP_COMPANY_SCOPE=*
APP_ALLOWED_HOSTS=
# Опционально при устаревшем CA хранилище macOS; см. scripts/prepare_tls.py.
# SSL_CERT_FILE=runtime/cacert.pem
# Выбрано пользователем: OpenRouter + Gemma 4 26B A4B (free), 22.10.2026.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
LLM_API_CONTRACT=openai-chat-completions
LLM_API_KEY=
LLM_MODEL_ID=google/gemma-4-26b-a4b-it:free
LLM_MODEL_NAME=Gemma 4 26B A4B
LLM_MAPPING_CONFIRMED=true
LLM_ACCESS_MODE=free_trial
LLM_JSON_MODE=false
LLM_FREE_MAX_REQUESTS_24H=20
LLM_FREE_MAX_TOKENS_24H=100000
# Не выдумываем тарифы RUB для бесплатного тестового доступа.
LLM_INPUT_RUB_PER_MILLION=
LLM_OUTPUT_RUB_PER_MILLION=
# true только если ВСЕ запросы общего ключа проходят через этот ledger.
LLM_SHARED_LEDGER_CONFIRMED=false
